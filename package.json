{
    "name": "app.scribere.sh",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.2.10",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "husky && svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "pre-commit": "lint-staged",
        "format:ci": "dprint check",
        "format": "dprint fmt",
        "lint": "eslint .",
        "test:ci": "vitest --run --reporter=junit --outputFile=junit.xml",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run",
        "deploy": "wrangler deploy",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate-dev": "wrangler d1 migrations apply DB --local",
        "email:dev": "email dev --dir src/lib/server/email/toxic-waste"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250525.0",
        "@eslint/compat": "^1.2.9",
        "@eslint/js": "^9.27.0",
        "@lucide/svelte": "^0.511.0",
        "@sveltejs/adapter-cloudflare": "^7.0.3",
        "@sveltejs/kit": "^2.21.1",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.1.7",
        "@tanstack/eslint-plugin-query": "^5.78.0",
        "@tanstack/svelte-query-devtools": "^5.77.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.8",
        "@types/react": "^19.1.5",
        "@vitest/coverage-v8": "^3.1.4",
        "bits-ui": "^1.8.0",
        "clsx": "^2.1.1",
        "dprint": "^0.50.0",
        "drizzle-kit": "^0.31.1",
        "eslint": "^9.27.0",
        "eslint-plugin-drizzle": "^0.2.3",
        "eslint-plugin-svelte": "^3.9.0",
        "eslint-plugin-tsdoc": "^0.4.0",
        "formsnap": "^2.0.1",
        "globals": "^16.2.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^16.0.0",
        "svelte": "^5.33.3",
        "svelte-check": "^4.2.1",
        "tailwind-merge": "^3.3.0",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.7",
        "tw-animate-css": "^1.3.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.1",
        "vite": "^6.3.5",
        "vite-plugin-kit-routes": "^0.8.4",
        "vitest": "^3.1.4",
        "wrangler": "^4.16.1"
    },
    "dependencies": {
        "@hono/arktype-validator": "^2.0.1",
        "@oslojs/binary": "^1.0.0",
        "@oslojs/crypto": "^1.0.1",
        "@oslojs/encoding": "^1.1.0",
        "@oslojs/jwt": "^0.3.0",
        "@oslojs/otp": "^1.1.0",
        "@pilcrowjs/object-parser": "^0.0.4",
        "@react-email/components": "^0.0.41",
        "@react-email/render": "^1.1.2",
        "@tanstack/svelte-query": "^5.77.2",
        "arctic": "^3.7.0",
        "arktype": "^2.1.20",
        "cbor2": "^2.0.1",
        "drizzle-orm": "^0.43.1",
        "hono": "^4.7.10",
        "mode-watcher": "^1.0.7",
        "obscenity": "^0.4.3",
        "paneforge": "^0.0.6",
        "react": "^19.1.0",
        "react-email": "^4.0.15",
        "resend": "^4.5.1",
        "svelte-sonner": "^1.0.3",
        "sveltekit-superforms": "^2.25.0",
        "uqr": "^0.1.2"
    },
    "trustedDependencies": [
        "@tailwindcss/oxide",
        "dprint",
        "esbuild",
        "sharp",
        "workerd"
    ]
}
