{
    "name": "app.scribere.sh",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.2.10",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "husky && svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "pre-commit": "lint-staged",
        "format:ci": "dprint check",
        "format": "dprint fmt",
        "lint": "eslint .",
        "test:ci": "vitest --run --reporter=junit --outputFile=junit.xml",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run",
        "deploy": "wrangler deploy",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate-dev": "wrangler d1 migrations apply DB --local",
        "email:dev": "email dev --dir src/lib/server/email/toxic-waste"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250427.0",
        "@elysiajs/server-timing": "^1.2.1",
        "@eslint/compat": "^1.2.8",
        "@eslint/js": "^9.25.1",
        "@lucide/svelte": "^0.503.0",
        "@sveltejs/adapter-cloudflare": "^7.0.1",
        "@sveltejs/kit": "^2.20.7",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.1.4",
        "@tanstack/svelte-query-devtools": "^5.74.7",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.7",
        "@types/react": "^19.1.2",
        "@vitest/coverage-v8": "^3.1.2",
        "bits-ui": "^1.3.19",
        "clsx": "^2.1.1",
        "dprint": "^0.49.1",
        "drizzle-kit": "^0.31.0",
        "eslint": "^9.25.1",
        "eslint-plugin-drizzle": "^0.2.3",
        "eslint-plugin-svelte": "^3.5.1",
        "eslint-plugin-tsdoc": "^0.4.0",
        "formsnap": "^2.0.1",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^15.5.1",
        "svelte": "^5.28.2",
        "svelte-check": "^4.1.6",
        "tailwind-merge": "^3.2.0",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.4",
        "tw-animate-css": "^1.2.8",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.31.0",
        "vite": "^6.3.3",
        "vite-plugin-kit-routes": "^0.8.4",
        "vitest": "^3.1.2",
        "wrangler": "^4.13.2"
    },
    "dependencies": {
        "@ap0nia/eden-svelte-query": "^1.7.0",
        "@elysiajs/cors": "^1.2.0",
        "@libsql/client": "^0.15.4",
        "@oslojs/binary": "^1.0.0",
        "@oslojs/crypto": "^1.0.1",
        "@oslojs/encoding": "^1.1.0",
        "@oslojs/jwt": "^0.3.0",
        "@oslojs/otp": "^1.1.0",
        "@pilcrowjs/object-parser": "^0.0.4",
        "@react-email/components": "^0.0.36",
        "@react-email/render": "^1.0.6",
        "@tanstack/svelte-query": "^5.74.7",
        "arctic": "^3.6.0",
        "arktype": "^2.1.20",
        "drizzle-orm": "^0.43.1",
        "elysia": "^1.2.25",
        "id128": "^1.6.6",
        "mode-watcher": "^1.0.2",
        "paneforge": "^0.0.6",
        "react": "^19.1.0",
        "react-email": "^4.0.7",
        "resend": "^4.4.1",
        "svelte-sonner": "^0.3.28",
        "sveltekit-superforms": "^2.24.1",
        "uqr": "^0.1.2"
    }
}
