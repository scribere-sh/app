{
    "$schema": "node_modules/wrangler/config-schema.json",

    // Project Name
    "name": "scribere-app",

    // Required Compat stuff
    "compatibility_date": "2025-02-27",
    "compatibility_flags": ["nodejs_compat"],

    // Workers Bindings
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare",
    },

    // need localhost to work in dev
    //
    // cookies are dumb
    "dev": {
        "ip": "localhost",
    },

    // i need to see stuff happen
    "observability": {
        "enabled": true,
    },

    // Variables
    "vars": {
        // Private Secrets - Managed in CF UI
        // - "RESEND_API_KEY"
        // - "DATABASE_URL"
        // - "DATABASE_API_TOKEN"
        "WE_IN_THIS_WORKER": "true",

        // Sender email and name
        "SENDER_EMAIL": "noreply@scribere.sh",
        "SENDER_NAME": "Scribere",

        // for use in the public area
        "PUBLIC_ORIGIN": "https://app.scribere.sh",

        "ACCEPTING_REGISTRATIONS": "true",
    },

    // Binding to our ARGON2 Worker
    "services": [
        {
            "binding": "ARGON2",
            "service": "scribere-argon2-worker",
        },
    ],
    // Working with Cloudflare Images
    "images": {
        "binding": "IMAGES",
    },
    // Bucket for our files
    "r2_buckets": [
        {
            "binding": "R2",
            "bucket_name": "cdn-scribere-sh",
            "preview_bucket_name": "cdn-scribere-sh-dev",
        },
    ],
    // KV Namespace for signing keys
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "96399a918bc14e719079a37568db7837",
            "preview_id": "96399a918bc14e719079a37568db7837",
        },
        {
            "binding": "SESSIONS",
            "id": "5048b13530c846b38a661f61c2cf9e42",
            "preview_id": "6d14a32db6bc45edba633fd4177bbe0a",
        },
    ],
    // D1 Database
    "d1_databases": [
        {
            "binding": "DB",

            "database_name": "scribere",

            "database_id": "07cb39e9-a08e-429d-bdfa-d77710a6215e",
            "preview_database_id": "4ca531b5-3d73-43c7-aec9-7bd4c0834b45",

            "migrations_dir": "./drizzle",
        },
    ],

    // unsafe bindings
    "unsafe": {
        "bindings": [
            {
                "name": "RATELIMIT",
                "type": "ratelimit",
                "namespace_id": "999",
                "simple": {
                    "period": 60,
                    "limit": 1000,
                },
            },
        ],
    },
}
